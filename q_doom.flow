# Q-DOOM — tabular Q-learning on a headless Doom-like arena.
#
# Companion to https://github.com/godofecht/doom-flow
# Follows Flow's game-AI pattern (docs/tutorials/game-ai.md): re-simulate a
# compact combat loop with no graphics, train with stdlib/ai.flow Q-learning,
# evaluate against a random baseline, exit 0 only if the agent wins clearly.
#
# Arena: 12x12 grid, border walls, one "imp" that chases on Manhattan steps.
# Player: turn left / turn right / move forward / fire (hitscan along facing).
# State: ~9 bits (wall-ahead, LOS, enemy left/right, distance+health buckets).
#
# Run (Flow checkout on PATH / sibling ../flow):
#   ~/flow/flow run q_doom.flow

import "stdlib/ai.flow"

extern {
    function printf(fmt: string, v: f64) -> i32
}

const GRID: i32 = 12
const N_ACTIONS: i32 = 4
const ACT_LEFT: i32 = 0
const ACT_RIGHT: i32 = 1
const ACT_FORWARD: i32 = 2
const ACT_FIRE: i32 = 3

const POLICY_TRAIN: i32 = 0
const POLICY_GREEDY: i32 = 1
const POLICY_RANDOM: i32 = 2

const STEP_CAP: i32 = 200
const PLAYER_HP: i32 = 3
const IMP_HP: i32 = 2

# Facing: 0=N, 1=E, 2=S, 3=W
function dx_of(face: i32) -> i32 {
    if face == 1 { return 1 }
    if face == 3 { return 0 - 1 }
    return 0
}

function dy_of(face: i32) -> i32 {
    if face == 0 { return 0 - 1 }
    if face == 2 { return 1 }
    return 0
}

function turn_left(face: i32) -> i32 {
    return (face + 3) % 4
}

function turn_right(face: i32) -> i32 {
    return (face + 1) % 4
}

function abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

function in_bounds(x: i32, y: i32) -> bool {
    return x >= 1 and x < GRID - 1 and y >= 1 and y < GRID - 1
}

function env_rng_next(seed: u32) -> u32 {
    return seed * 1664525 + 1013904223
}

function clear_los(px: i32, py: i32, ex: i32, ey: i32) -> bool {
    # Axis-aligned hitscan only (Doom-ish hitscan in a grid).
    if px != ex and py != ey { return false }
    if px == ex {
        let mut y0: i32 = py
        let mut y1: i32 = ey
        if y0 > y1 {
            let t: i32 = y0
            y0 = y1
            y1 = t
        }
        let mut y: i32 = y0 + 1
        while y < y1 {
            if !in_bounds(px, y) { return false }
            y = y + 1
        }
        return true
    }
    let mut x0: i32 = px
    let mut x1: i32 = ex
    if x0 > x1 {
        let t: i32 = x0
        x0 = x1
        x1 = t
    }
    let mut x: i32 = x0 + 1
    while x < x1 {
        if !in_bounds(x, py) { return false }
        x = x + 1
    }
    return true
}

function facing_enemy(face: i32, px: i32, py: i32, ex: i32, ey: i32) -> bool {
    let dx: i32 = dx_of(face)
    let dy: i32 = dy_of(face)
    if dx != 0 {
        if py != ey { return false }
        if dx > 0 { return ex > px }
        return ex < px
    }
    if px != ex { return false }
    if dy > 0 { return ey > py }
    return ey < py
}

function on_left(face: i32, px: i32, py: i32, ex: i32, ey: i32) -> bool {
    let rx: i32 = ex - px
    let ry: i32 = ey - py
    # Left relative to facing via 2D cross (dx,dy) x (rx,ry) > 0
    let dx: i32 = dx_of(face)
    let dy: i32 = dy_of(face)
    return dx * ry - dy * rx > 0
}

function on_right(face: i32, px: i32, py: i32, ex: i32, ey: i32) -> bool {
    let rx: i32 = ex - px
    let ry: i32 = ey - py
    let dx: i32 = dx_of(face)
    let dy: i32 = dy_of(face)
    return dx * ry - dy * rx < 0
}

# Compact state hashed into [0, 512).
function state_of(px: i32, py: i32, face: i32, php: i32, ex: i32, ey: i32, ehp: i32) -> i32 {
    let ax: i32 = px + dx_of(face)
    let ay: i32 = py + dy_of(face)
    let mut s: i32 = 0
    if !in_bounds(ax, ay) { s = s + 1 }
    if ehp > 0 and facing_enemy(face, px, py, ex, ey) and clear_los(px, py, ex, ey) {
        s = s + 2
    }
    if ehp > 0 and on_left(face, px, py, ex, ey) { s = s + 4 }
    if ehp > 0 and on_right(face, px, py, ex, ey) { s = s + 8 }

    let dist: i32 = abs_i32(px - ex) + abs_i32(py - ey)
    let mut db: i32 = 0
    if dist > 2 { db = 1 }
    if dist > 5 { db = 2 }
    if dist > 8 { db = 3 }
    s = s + db * 16

    let mut hb: i32 = 0
    if php <= 2 { hb = 1 }
    if php <= 1 { hb = 2 }
    s = s + hb * 64

    if ehp > 0 { s = s + 256 }
    return s
}

# Returns kills this episode (0 or 1). Used as the score metric.
function run_episode(policy: i32, eps: f32, alpha: f32, gamma: f32, seed: u32) -> i32 {
    let mut rng: u32 = seed
    let mut px: i32 = 2
    let mut py: i32 = 2
    let mut face: i32 = 1
    let mut php: i32 = PLAYER_HP
    let mut ex: i32 = GRID - 3
    let mut ey: i32 = GRID - 3
    let mut ehp: i32 = IMP_HP
    let mut kills: i32 = 0
    let mut steps: i32 = 0
    let mut alive: bool = true

    while alive and ehp > 0 and steps < STEP_CAP {
        let s: i32 = state_of(px, py, face, php, ex, ey, ehp)
        let mut a: i32 = 0
        if policy == POLICY_TRAIN {
            a = q_select(s, N_ACTIONS, eps)
        } else {
            if policy == POLICY_GREEDY {
                a = q_best(s, N_ACTIONS)
            } else {
                rng = env_rng_next(rng)
                a = (rng % (N_ACTIONS as u32)) as i32
            }
        }

        let old_dist: i32 = abs_i32(px - ex) + abs_i32(py - ey)
        let mut r: f32 = -0.01
        let mut terminal: bool = false

        if a == ACT_LEFT {
            face = turn_left(face)
        } else {
            if a == ACT_RIGHT {
                face = turn_right(face)
            } else {
                if a == ACT_FORWARD {
                    let nx: i32 = px + dx_of(face)
                    let ny: i32 = py + dy_of(face)
                    if in_bounds(nx, ny) and !(nx == ex and ny == ey and ehp > 0) {
                        px = nx
                        py = ny
                    } else {
                        r = r - 0.4
                    }
                } else {
                    # Fire
                    if ehp > 0 and facing_enemy(face, px, py, ex, ey) and clear_los(px, py, ex, ey) {
                        ehp = ehp - 1
                        r = r + 5.0
                        if ehp <= 0 {
                            kills = 1
                            r = r + 20.0
                            terminal = true
                        }
                    } else {
                        r = r - 0.5
                    }
                }
            }
        }

        # Imp AI: every other tick, step toward the player on the longer axis.
        if !terminal and ehp > 0 and (steps % 2) == 0 {
            let mut ix: i32 = ex
            let mut iy: i32 = ey
            let adx: i32 = abs_i32(px - ex)
            let ady: i32 = abs_i32(py - ey)
            if adx >= ady {
                if px > ex { ix = ex + 1 }
                if px < ex { ix = ex - 1 }
            } else {
                if py > ey { iy = ey + 1 }
                if py < ey { iy = ey - 1 }
            }
            if in_bounds(ix, iy) and !(ix == px and iy == py) {
                ex = ix
                ey = iy
            } else {
                if in_bounds(ix, iy) and ix == px and iy == py {
                    # Melee bite
                    php = php - 1
                    r = r - 6.0
                    if php <= 0 {
                        alive = false
                        terminal = true
                        r = r - 15.0
                    }
                }
            }
        }

        if !terminal and ehp > 0 {
            let new_dist: i32 = abs_i32(px - ex) + abs_i32(py - ey)
            if facing_enemy(face, px, py, ex, ey) and new_dist < old_dist {
                r = r + 0.3
            }
            if new_dist > old_dist {
                r = r - 0.15
            }
        }

        if policy == POLICY_TRAIN {
            if terminal or !alive {
                q_update_terminal(s, a, r, alpha)
            } else {
                let s2: i32 = state_of(px, py, face, php, ex, ey, ehp)
                q_update(s, a, r, s2, N_ACTIONS, alpha, gamma)
            }
        }

        steps = steps + 1
    }

    return kills
}

function eval_policy(policy: i32, episodes: i32) -> f32 {
    let mut total: i32 = 0
    let mut i: i32 = 0
    while i < episodes {
        let seed: u32 = 4242 + (i as u32) * 17
        total = total + run_episode(policy, 0.0, 0.0, 0.0, seed)
        i = i + 1
    }
    return (total as f32) / (episodes as f32)
}

function main() -> i32 {
    println("Q-DOOM: tabular Q-learning on a headless Doom-like arena")
    println("companion to doom-flow; trainers from Flow stdlib/ai.flow")
    println("actions: turn L/R, forward, fire | goal: kill the imp")
    println("")

    let episodes: i32 = 5000
    let decay_over: i32 = 3500
    let alpha: f32 = 0.12
    let gamma: f32 = 0.92
    let eval_eps: i32 = 100

    ai_seed(9999 as u32)
    let base_avg: f32 = eval_policy(POLICY_RANDOM, eval_eps)
    print("random baseline: kill-rate ")
    printf("%.2f", base_avg as f64)
    print(" over ")
    print(eval_eps)
    println(" episodes")
    println("")

    q_init(1337 as u32)
    println("training 5000 episodes (epsilon 1.00 -> 0.05 over 3500):")
    let mut window: i32 = 0
    let mut ep: i32 = 0
    while ep < episodes {
        let eps: f32 = q_epsilon(ep, decay_over, 1.0, 0.05)
        let seed: u32 = 900 + (ep as u32) * 97
        window = window + run_episode(POLICY_TRAIN, eps, alpha, gamma, seed)
        ep = ep + 1

        if ep % 500 == 0 {
            let avg: f32 = (window as f32) / 500.0
            print("  episode ")
            print(ep)
            print("  kill-rate ")
            printf("%.2f", avg as f64)
            print("  epsilon ")
            printf("%.2f", eps as f64)
            println("")
            window = 0
        }
    }

    println("")
    let trained: f32 = eval_policy(POLICY_GREEDY, eval_eps)
    print("trained (greedy): kill-rate ")
    printf("%.2f", trained as f64)
    print(" over ")
    print(eval_eps)
    println(" episodes")

    # Must beat random by a clear margin (same gate style as q_snake).
    if trained > base_avg + 0.25 and trained > 0.40 {
        println("PASS: agent learned to clear the arena vs random baseline")
        return 0
    }
    println("FAIL: trained agent did not beat random by enough")
    return 1
}
